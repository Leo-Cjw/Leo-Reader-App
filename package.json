{
  "name": "reader-local-first",
  "version": "0.29.0",
  "description": "A private, local-first reading and knowledge workspace for macOS.",
  "author": "Reader",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4311",
    "server": "node src/server/server.mjs",
    "build": "tsc -b && vite build",
    "start": "node src/server/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "benchmark:library": "node scripts/benchmark-library.mjs",
    "benchmark:rag": "node scripts/benchmark-rag.mjs",
    "icon:mac": "node scripts/build-mac-icon.mjs",
    "desktop": "npm run build && electron .",
    "desktop:pack:x64": "npm run build && npm run icon:mac && electron-builder --mac dir --x64",
    "desktop:pack": "node scripts/build-mac-release.mjs",
    "desktop:dmg": "node scripts/build-mac-dmg.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^0.1.65",
    "archiver": "^7.0.1",
    "linkedom": "^0.18.13",
    "pdfjs-dist": "^4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@electron/notarize": "2.5.0",
    "@electron/osx-sign": "1.3.3",
    "@electron/universal": "2.0.3",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "41.7.1",
    "electron-builder": "^26.15.3",
    "typescript": "5.7.3",
    "vite": "^6.4.3"
  },
  "build": {
    "appId": "com.reader.localfirst",
    "productName": "Reader",
    "asar": true,
    "asarUnpack": [
      "node_modules/@napi-rs/**/*"
    ],
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "src/server/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "icon": "build/Reader.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
